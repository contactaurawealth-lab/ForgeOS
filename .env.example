# ForgeOS Configuration Template
# Copy this file to .env and configure as needed.

NODE_ENV=development
PORT=3000
FORGEOS_WORKSPACE_ROOT=./projects
FORGEOS_LOG_LEVEL=info

# AI Provider: 'mock' (default, offline), 'openai', 'anthropic', or 'gemini'
AI_PROVIDER=mock

# Model Provider Credentials (Required only when AI_PROVIDER is not 'mock')
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-pro-latest

# Agent & Repair Configuration
FORGEOS_MAX_REPAIR_ATTEMPTS=3
FORGEOS_TOOL_TIMEOUT_MS=30000
